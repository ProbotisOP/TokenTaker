# Start with observation only. No wallet or paid feed is used by default.
EARLY_FEED_ENABLED=false
# No provider is selected. PUMPPORTAL is the only implemented live adapter;
# non-Pump discovery requires a verified venue adapter, not a Phantom wallet key.
EARLY_FEED_PROVIDER=NONE
PUMPPORTAL_ENABLE_TRADES=false
PUMPPORTAL_API_KEY=

# Private RPC capacity is recommended for frequent confirmed account inspections.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Required for the documented Jupiter quote/swap API, never a wallet private key.
JUPITER_API_KEY=

# Leave false for validation. Real Phantom swaps additionally require explicit
# manual LIVE enable in the UI and a fresh Phantom signature for every buy/sell.
# Dedicated autotrade retains its separate keypair/preflight authorization gates.
ENABLE_LIVE_TRADING=false

# Optional legacy demo/AI features.
GEMINI_API_KEY=
APP_URL=http://localhost:3000
