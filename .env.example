# Start with observation only. No wallet or paid feed is used by default.
EARLY_FEED_ENABLED=false
PUMPPORTAL_ENABLE_TRADES=false
PUMPPORTAL_API_KEY=

# Private RPC capacity is recommended for frequent confirmed account inspections.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_KEY=

# This is only one interlock. LIVE mode, wallet preflight and explicit autotrade
# authorization are also required. Leave false for validation.
ENABLE_LIVE_TRADING=false

# Optional legacy demo/AI features.
GEMINI_API_KEY=
APP_URL=http://localhost:3000
